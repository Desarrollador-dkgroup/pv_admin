# Conexión pública al mismo proyecto de Supabase que utiliza Panamá Viajero.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo para el servidor: crea cuentas del equipo con la clave de servicio de Supabase.
# NO usar prefijo NEXT_PUBLIC_. Configurarla también como secreto en Cloudflare Workers.
SUPABASE_SERVICE_ROLE_KEY=
